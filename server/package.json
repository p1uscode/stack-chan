{
  "name": "stackchan-servers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StackChan の補助サーバ群(gateway/mcp/tools)。ロボットから会話ループを引き取る LAN 側ホストで動かす。実行は tsx、型チェックは tsgo。Node 24 系。",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#gateway/*": "./src/gateway/*",
    "#mcp/*": "./src/mcp/*",
    "#tools/*": "./src/tools/*",
    "#codex/*": "./vendor/codex-voice/*"
  },
  "scripts": {
    "postinstall": "node vendor/scripts/patch-werift-consent.mjs",
    "gateway": "tsx src/gateway/index.ts",
    "all": "tsx src/start-all.ts",
    "mcp": "tsx src/mcp/index.ts",
    "search": "tsx src/tools/search.ts",
    "docs": "tsx src/tools/docs.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "@discordjs/opus": "0.10.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "werift": "0.24.1",
    "ws": "8.21.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsx": "4.23.0"
  }
}
